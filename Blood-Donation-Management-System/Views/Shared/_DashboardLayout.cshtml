@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var currentUser = User.Identity?.Name ?? "Admin";
    var currentRole = User.FindFirstValue(ClaimTypes.Role) ?? "Staff";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] - Save Life Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.4.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --tblr-primary: #d32f2f;
            --tblr-primary-rgb: 211, 47, 47;
            --tblr-primary-fg: #ffffff;
            --tblr-primary-darken: #b71c1c;
            --tblr-primary-lighten: #ef5350;
            --tblr-link-color: #d32f2f;
            --tblr-link-hover-color: #9a0007;
        }

        body {
            font-family: 'Pyidaungsu', 'Padauk', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        .navbar-brand .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: linear-gradient(135deg, #d32f2f, #9a0007);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            margin-right: 10px;
        }

        .navbar-vertical .navbar-brand {
            padding-top: 0.75rem;
            padding-bottom: 0.75rem;
        }

        .nav-item.active > .nav-link,
        .nav-link:hover {
            color: #fff;
        }

        .nav-item.active > .nav-link {
            background: rgba(211, 47, 47, 0.18);
            border-left: 3px solid #d32f2f;
        }

        .page-body {
            margin-top: 1.5rem;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #fff;
        }

        .badge-outline {
            color: var(--tblr-primary);
            border: 1px solid currentColor;
        }
    </style>
</head>
<body>
    <input type="hidden" id="antiforgeryToken" value="@antiforgeryToken" />
    <div class="page">
        <!-- Sidebar -->
        <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
            <div class="container-fluid">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <h1 class="navbar-brand navbar-brand-autodark">
                    <a asp-controller="Dashboard" asp-action="Index" class="d-flex align-items-center text-reset text-decoration-none">
                        <span class="brand-mark"><i class="fa-solid fa-droplet"></i></span>
                        <span class="fw-bold">Save Life</span>
                    </a>
                </h1>
                <div class="collapse navbar-collapse" id="sidebar-menu">
                    <ul class="navbar-nav pt-lg-3">
                        <li class="nav-item active">
                            <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-gauge-high"></i></span>
                                <span class="nav-link-title">Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-calendar-check"></i></span>
                                <span class="nav-link-title">Bookings</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-users"></i></span>
                                <span class="nav-link-title">Donors</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-boxes-stacked"></i></span>
                                <span class="nav-link-title">Blood Inventory</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-hospital"></i></span>
                                <span class="nav-link-title">Centers</span>
                            </a>
                        </li>
                        <li class="nav-item mt-2">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="fa-solid fa-globe"></i></span>
                                <span class="nav-link-title">Back to Site</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </aside>

        <div class="page-wrapper">
            <!-- Top navbar -->
            <header class="navbar navbar-expand-lg navbar-light d-print-none">
                <div class="container-xl">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal m-0 ms-3">
                        <a asp-controller="Dashboard" asp-action="Index" class="text-reset text-decoration-none">Dashboard</a>
                    </h1>
                    <div class="navbar-nav flex-row order-md-last">
                        <div class="nav-item dropdown">
                            <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                                <span class="avatar avatar-sm" style="background: linear-gradient(135deg,#d32f2f,#9a0007); color: #fff; display:flex; align-items:center; justify-content:center;">
                                    <i class="fa-solid fa-user-shield"></i>
                                </span>
                                <div class="d-none d-xl-block ps-2">
                                    <div class="fw-semibold">@currentUser</div>
                                    <div class="mt-1 small text-secondary">@currentRole</div>
                                </div>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                <a href="#" class="dropdown-item"><i class="fa-solid fa-user me-2 text-secondary"></i>Profile</a>
                                <a href="#" class="dropdown-item"><i class="fa-solid fa-gear me-2 text-secondary"></i>Settings</a>
                                <div class="dropdown-divider"></div>
                                <a href="#" class="dropdown-item text-danger" data-logout><i class="fa-solid fa-right-from-bracket me-2"></i>Logout</a>
                            </div>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse" id="navbar-menu"></div>
                </div>
            </header>

            <div class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>

            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
                    <div>Copyright &copy; 2026 Save Life. All rights reserved.</div>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-secondary text-decoration-none">Privacy</a>
                        <a href="#" class="text-secondary text-decoration-none">Terms</a>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.4.0/dist/js/tabler.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
